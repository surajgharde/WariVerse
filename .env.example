# ---------------------------------------------------------------------------
# WariVerse — environment template.
#
#   python services/core-api/scripts/gen_env.py > .env     # recommended
#   cp .env.example .env                                   # or edit by hand
#
# Never commit .env.  Secrets live here or in a secret manager, never in code.
#
# ===========================================================================
#  EXTERNAL SERVICES: ZERO ARE REQUIRED. ZERO ARE PAID.
# ===========================================================================
#
# The whole system runs — every module, the full demo — with no account
# anywhere and no key from anyone. That is deliberate, not a limitation:
#
#   * Crowd intelligence     runs on the built-in simulation engine
#                            (CROWD_SOURCE=sim, the default). No cameras, no
#                            cloud vision API, no GPU. Switch to real CCTV by
#                            pointing it at RTSP URLs you already own.
#   * Maps                   MapLibre drawing our OWN zone polygons on a flat
#                            background. No tile CDN, no Mapbox/MapTiler key.
#                            A control room during the Wari is exactly where a
#                            map that blocks on a tile CDN fails.
#   * Database / cache       self-hosted Postgres + Redis via docker compose.
#   * Detection weights      YOLOv8 (AGPL, free) — only if you enable vision.
#   * Everything below       generated locally by you; see gen_env.py.
#
# The ONE optional external key is GEMINI_API_KEY, which has a free tier
# (Google AI Studio). Leave it blank and the assistant still answers — see
# the assistant section near the bottom for what changes.
#
# There is no SMS gateway key, no push-notification key and no map key,
# because nothing in the codebase reads one.
# ===========================================================================

# --- Postgres (TimescaleDB + PostGIS) --------------------------------------
POSTGRES_USER=wariverse
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=wariverse
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://wariverse:change-me-in-prod@db:5432/wariverse

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Core API ---------------------------------------------------------------
CORE_API_PORT=8000
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO

# 32+ byte random strings.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-change-me-0000000000000000
# HMAC key used to hash pilgrim phone numbers (PII rule, Section 12).
# Rotating this orphans every existing phone hash — treat as permanent.
PHONE_HASH_SECRET=dev-only-phone-hash-secret-change-me-000000
# Fernet key for the encrypted contact table.  Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTACT_ENCRYPTION_KEY=
# Root secret for the daily pass-signing keypair. Rotating this invalidates
# every QR already in a pilgrim's pocket.
QR_SIGNING_SECRET=dev-only-qr-signing-secret-change-me-00000

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Vite dev servers: 5173 admin console, 5174 pilgrim PWA, 5175 volunteer app.
# In Docker the console is served by its own nginx, which reverse-proxies /api
# to core-api — so the browser sees one origin and CORS is not involved at all.
# This list matters only for `npm run dev` against a containerised API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- OTP --------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_PER_HOUR=3
# development only: returns the OTP in the API response so you can test without
# an SMS gateway.  MUST be false anywhere real.
OTP_DEBUG_ECHO=true

# --- Admin console (Section 4/M3, Phase 4) ----------------------------------
ADMIN_CONSOLE_PORT=5173

# --- Pilgrim PWA (Section 4/M7, Phase 7) ------------------------------------
PILGRIM_PWA_PORT=5174
# Optional basemap style URL for the density map. Left unset the console draws
# its own zone polygons on a flat background and needs no network at all —
# which is the right default for a control room whose uplink is the first thing
# to saturate during the Wari.
# VITE_MAP_STYLE=

# --- Development sign-in (Phase 1 convenience) ------------------------------
# One-click sign-in as a seeded staff account from the admin console, with no
# password and no TOTP. Off by default; the app REFUSES TO BOOT in production
# with this on, the same as OTP_DEBUG_ECHO.
DEV_LOGIN_ENABLED=true
# Fixed TOTP secret seeded onto the MFA roles in development, so the ordinary
# password + TOTP path also works. Real deployments enrol per user and seed
# nothing.
DEV_MFA_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# --- Rate limits (Section 9) ------------------------------------------------
RATE_LIMIT_PASS_BOOKING_PER_DAY=5
RATE_LIMIT_SOS_PER_10MIN=3

# --- Crowd engine (Section 4/M2) -------------------------------------------
CROWD_SOURCE=sim                   # live | video | sim
AI_ENGINE_URL=http://ai-engine:8100
AI_ENGINE_PORT=8100
CORE_API_URL=http://core-api:8000
# Shared secret the AI service uses to publish events into the core API, and
# the one that guards /sim/inject on the engine itself.
AI_SERVICE_TOKEN=dev-only-ai-service-token-change-me

# A reading older than this renders as stale everywhere.
STALE_READING_SECONDS=90
# Redis TTL for the latest zone snapshot.  This is a safety property, not a
# cache tuning knob: when the AI engine dies the snapshot expires and the map
# says "no data" instead of freezing on a green zone.
DENSITY_CACHE_TTL_SECONDS=300
CAMERA_OFFLINE_SECONDS=120
ALERT_COOLDOWN_SECONDS=180

# --- AI engine pipeline -----------------------------------------------------
# 30 FPS is wasted compute for crowd density (Section 4/M2 step 1).
SAMPLE_FPS=2.0
WINDOW_SECONDS=10
STAGNATION_WINDOW_SECONDS=60
# Head-detection weights beat full-body past ~4 p/m², which is where the number
# starts to matter.  Point this at a head checkpoint for dense zones.
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.25
YOLO_DEVICE=cpu
# CROWD_SOURCE=video reads sample clips from here (mounted at ./data/videos).
VIDEO_DIR=/data/videos

# --- Simulation (Section 4/M2 SIMULATION MODE — REQUIRED) -------------------
# Seeded, so a demo run is reproducible and a test can assert on it.
SIM_SEED=20260724
SIM_EKADASHI_DATE=2026-07-25       # Ashadhi Ekadashi; the surge centres here
SIM_BASELINE_MULTIPLIER=1.0

# Build the ai-engine image with the ~2 GB vision stack (torch, ultralytics,
# opencv).  Leave at 0 for development and demos — sim mode needs none of it.
WITH_VISION=0

# --- Control room contact ---------------------------------------------------
# NOT an API key and NOT a paid service. This is simply the control room's own
# phone number, printed on the pilgrim app's offline screen so an SOS has
# somewhere to go when the app cannot reach the API at all (Section 4/M4).
# Leave it blank and the app says "no number configured" rather than rendering
# a button that dials nothing.
#
# Removed from this file deliberately: SMS_PROVIDER, SMS_API_KEY and
# FCM_SERVER_KEY. They named paid Indian SMS gateways (MSG91, Gupshup) and a
# Firebase push key, and **no code in this repository ever read any of them** —
# they were aspirational placeholders. Keeping them would have implied a paid
# dependency the project does not have. If you later add a real gateway, add
# the setting to `app/core/config.py` at the same time, so the template and the
# code cannot drift apart again.
CONTROL_ROOM_SMS_NUMBER=

# --- Gemini assistant (Section 13, Phase 9) --------------------------------
# Leaving GEMINI_API_KEY empty is a SUPPORTED state, not a broken one. With no
# key the assistant answers from its deterministic fallback — the same five
# read-only tools, templated bilingual sentences instead of fluent prose — and
# every turn is logged with outcome `degraded`. Demos, CI runs and a lapsed
# billing account all land in that path, which makes it the one most likely to
# be running on any given day. Section 11: every module has a manual mode.
#
# The assistant can also be switched off entirely at runtime without a deploy:
#   system_config.assistant_enabled = false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Palkhi & Dindi tracking (Section 4/M8, Phase 9) ------------------------
# Tunables live in `system_config`, not here, so a district administration can
# change them mid-Wari without a deploy. The ones worth knowing about:
#
#   dindi_deviation_minutes        45    schedule gap that notifies the next town
#   dindi_ping_interval_seconds    60    base reporting interval, backed off by battery
#   dindi_signal_lost_minutes      20    silence after which a Dindi reads as signal_lost
#   dindi_pace_window_minutes      90    window the walking pace is averaged over
#   halt_water_points_per_1000     4     provisioning ratio for the readiness board
#   halt_sanitation_units_per_1000 10
#   halt_medical_camps_per_10000   1
#
# Note what is NOT tunable, here or there: the crowd-density bands. Those are
# published crowd-safety figures and live in code, so nobody under pressure can
# make a critical zone look safe by editing a row. Provisioning ratios are
# planning conventions and genuinely do get argued about, so they are config —
# and the readiness board prints the ratio it used.

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
# Basemap: intentionally unset. See the VITE_MAP_STYLE note further up — the
# console draws its own polygons and needs no tile server, so there is no map
# key to obtain. (This line previously read VITE_MAP_STYLE_URL, which no code
# reads; the variable the console actually looks for is VITE_MAP_STYLE.)

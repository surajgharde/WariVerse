# ---------------------------------------------------------------------------
# WariVerse — environment template.  Copy to .env and edit.
#   cp .env.example .env
# Never commit .env.  Secrets live here or in a secret manager, never in code.
# ---------------------------------------------------------------------------

# --- Postgres (TimescaleDB + PostGIS) --------------------------------------
POSTGRES_USER=wariverse
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=wariverse
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://wariverse:change-me-in-prod@db:5432/wariverse

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Core API ---------------------------------------------------------------
CORE_API_PORT=8000
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO

# 32+ byte random strings.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-change-me-0000000000000000
# HMAC key used to hash pilgrim phone numbers (PII rule, Section 12).
# Rotating this orphans every existing phone hash — treat as permanent.
PHONE_HASH_SECRET=dev-only-phone-hash-secret-change-me-000000
# Fernet key for the encrypted contact table.  Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTACT_ENCRYPTION_KEY=
# Root secret for the daily pass-signing keypair. Rotating this invalidates
# every QR already in a pilgrim's pocket.
QR_SIGNING_SECRET=dev-only-qr-signing-secret-change-me-00000

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Vite dev servers: 5173 admin console, 5174 pilgrim PWA, 5175 volunteer app.
# In Docker the console is served by its own nginx, which reverse-proxies /api
# to core-api — so the browser sees one origin and CORS is not involved at all.
# This list matters only for `npm run dev` against a containerised API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- OTP --------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_PER_HOUR=3
# development only: returns the OTP in the API response so you can test without
# an SMS gateway.  MUST be false anywhere real.
OTP_DEBUG_ECHO=true

# --- Admin console (Section 4/M3, Phase 4) ----------------------------------
ADMIN_CONSOLE_PORT=5173
# Optional basemap style URL for the density map. Left unset the console draws
# its own zone polygons on a flat background and needs no network at all —
# which is the right default for a control room whose uplink is the first thing
# to saturate during the Wari.
# VITE_MAP_STYLE=

# --- Development sign-in (Phase 1 convenience) ------------------------------
# One-click sign-in as a seeded staff account from the admin console, with no
# password and no TOTP. Off by default; the app REFUSES TO BOOT in production
# with this on, the same as OTP_DEBUG_ECHO.
DEV_LOGIN_ENABLED=true
# Fixed TOTP secret seeded onto the MFA roles in development, so the ordinary
# password + TOTP path also works. Real deployments enrol per user and seed
# nothing.
DEV_MFA_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# --- Rate limits (Section 9) ------------------------------------------------
RATE_LIMIT_PASS_BOOKING_PER_DAY=5
RATE_LIMIT_SOS_PER_10MIN=3

# --- Crowd engine (Section 4/M2) -------------------------------------------
CROWD_SOURCE=sim                   # live | video | sim
AI_ENGINE_URL=http://ai-engine:8100
AI_ENGINE_PORT=8100
CORE_API_URL=http://core-api:8000
# Shared secret the AI service uses to publish events into the core API, and
# the one that guards /sim/inject on the engine itself.
AI_SERVICE_TOKEN=dev-only-ai-service-token-change-me

# A reading older than this renders as stale everywhere.
STALE_READING_SECONDS=90
# Redis TTL for the latest zone snapshot.  This is a safety property, not a
# cache tuning knob: when the AI engine dies the snapshot expires and the map
# says "no data" instead of freezing on a green zone.
DENSITY_CACHE_TTL_SECONDS=300
CAMERA_OFFLINE_SECONDS=120
ALERT_COOLDOWN_SECONDS=180

# --- AI engine pipeline -----------------------------------------------------
# 30 FPS is wasted compute for crowd density (Section 4/M2 step 1).
SAMPLE_FPS=2.0
WINDOW_SECONDS=10
STAGNATION_WINDOW_SECONDS=60
# Head-detection weights beat full-body past ~4 p/m², which is where the number
# starts to matter.  Point this at a head checkpoint for dense zones.
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.25
YOLO_DEVICE=cpu
# CROWD_SOURCE=video reads sample clips from here (mounted at ./data/videos).
VIDEO_DIR=/data/videos

# --- Simulation (Section 4/M2 SIMULATION MODE — REQUIRED) -------------------
# Seeded, so a demo run is reproducible and a test can assert on it.
SIM_SEED=20260724
SIM_EKADASHI_DATE=2026-07-25       # Ashadhi Ekadashi; the surge centres here
SIM_BASELINE_MULTIPLIER=1.0

# Build the ai-engine image with the ~2 GB vision stack (torch, ultralytics,
# opencv).  Leave at 0 for development and demos — sim mode needs none of it.
WITH_VISION=0

# --- Notifications (Phase 5+) ----------------------------------------------
SMS_PROVIDER=none                  # none | msg91 | gupshup
SMS_API_KEY=
CONTROL_ROOM_SMS_NUMBER=
FCM_SERVER_KEY=

# --- Gemini assistant (Phase 9) --------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_MAP_STYLE_URL=/map/style.json

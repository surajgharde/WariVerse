# ---------------------------------------------------------------------------
# WariVerse backend — environment configuration
# Copy to `.env` and fill in real values. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------
# Hostnames are the compose service names. Running outside Docker? Use
# localhost. A plain postgresql:// URL gets the async driver added for you.
DATABASE_URL=postgresql+asyncpg://wariverse:password@postgres:5432/wariverse
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=sk-...
# At least 32 characters. Startup logs an error if it is shorter or unchanged.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-secret-here-min-32-chars
# Protects every /api/admin/* route and the SOS status endpoints. Unset means
# they refuse all requests — they never fall open.
ADMIN_API_KEY=...

# --- Compose ---------------------------------------------------------------
# Used by docker-compose.yml only.
POSTGRES_PASSWORD=password
API_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443
MAPBOX_ACCESS_TOKEN=replace-with-your-mapbox-token

# --- App -------------------------------------------------------------------
ENVIRONMENT=local          # local | dev | staging | production
DEBUG=true
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_JSON=true

# --- CORS ------------------------------------------------------------------
# Comma-separated or a JSON array — both work. The Expo dev client is on :8081.
CORS_ORIGINS=http://localhost:8081,https://wariverse.app
# Wildcard subdomains cannot be expressed in CORS_ORIGINS, so *.wariverse.app
# is matched with this regex instead.
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*wariverse\.app$

# --- Database pool ---------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis -----------------------------------------------------------------
REDIS_TTL_SECONDS=300

# --- LLM -------------------------------------------------------------------
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=20
# When false the orchestrator always uses the offline rule-based responder.
LLM_ENABLED=true

# --- Auth / OTP ------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200   # 30 days — pilgrims stay logged in for the walk
OTP_TTL_SECONDS=600        # 10 minutes
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
# Max OTPs per phone per window. SMS costs money and an unmetered send endpoint
# is an SMS-bombing tool.
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW_SECONDS=3600
# Returns the OTP as `demo_otp` AND prints it to the console, so you can test
# without an SMS gateway. Forced OFF when ENVIRONMENT=production.
OTP_DEBUG_ECHO=true

# --- SMS -------------------------------------------------------------------
# console | fast2sms | twilio
SMS_PROVIDER=console
# Fast2SMS — India only, the cheapest route for +91 numbers.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=FSTSMS
# Twilio — SMS fallback, and the Voice IVR helpline.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_TIMEOUT_SECONDS=10

# --- Speech to text (app voice input) --------------------------------------
# Deepgram is tried first, OpenAI Whisper picks up whatever it drops.
# NOTE: verify Marathi is on Deepgram's Nova-2 language list for your account —
# Whisper handles mr reliably, Deepgram historically has not.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
VOICE_MAX_UPLOAD_BYTES=10485760   # 10 MB, checked before any paid call
VOICE_MAX_DURATION_SECONDS=60
VOICE_TIMEOUT_SECONDS=30

# --- Text to speech (read-aloud) -------------------------------------------
# English and Hindi go to ElevenLabs; Marathi to Google, which pronounces it
# properly. Output is cached in Redis for 24 h.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=9BWtsMINqrJLrRacOk9x   # "Aria" — verify against your account
ELEVENLABS_MODEL=eleven_multilingual_v2
# Either a service-account JSON path...
GOOGLE_APPLICATION_CREDENTIALS=
# ...or a plain API key, whichever suits the deployment.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE_MR=mr-IN-Wavenet-A
TTS_CACHE_TTL_SECONDS=86400
TTS_MAX_CHARACTERS=1000

# Static in-app IVR menu audio (greeting, menu, SOS confirmation, goodbye) is
# synthesised once at boot and kept far longer than an ordinary reply — the copy
# only changes when app/services/ivr_state.py does. Warming is skipped unless
# OPENAI_API_KEY and Redis are both available, and only one worker does it.
IVR_STATIC_AUDIO_TTL_SECONDS=2592000
IVR_WARM_AUDIO_ON_STARTUP=true
# How long a completed IVR turn can be replayed to a client that retried it
# because the answer was lost in transit. Keeps one tap from advancing the menu
# twice on a weak connection.
IVR_TURN_REPLAY_TTL_SECONDS=120

# --- Voice IVR -------------------------------------------------------------
# Twilio webhooks are public URLs and digit 9 dispatches responders, so every
# request is signature-checked against TWILIO_AUTH_TOKEN. Turning this off is
# for local testing only — an unset auth token makes the endpoints 503.
IVR_VALIDATE_SIGNATURE=true
# The public https:// origin Twilio calls. REQUIRED behind a proxy: signature
# validation hashes the URL, and internally `request.url` is usually http://,
# which would never match what Twilio signed.
IVR_PUBLIC_BASE_URL=
IVR_SPEECH_TIMEOUT_SECONDS=8
IVR_HOLD_MUSIC_URL=http://com.twilio.music.classical.s3.amazonaws.com/BusyStrings.wav

# --- Admin -----------------------------------------------------------------
# Protects POST /api/admin/*, sent as the X-API-Key header. Leave UNSET and the
# admin endpoints refuse every request — there is no "open when unconfigured"
# mode. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Crowd simulator -------------------------------------------------------
# Stand-in for the CCTV/drone feed: writes modelled readings every interval.
# ⚠️ Run in ONE process only — with several uvicorn workers each runs its own
# copy and they overwrite each other. Turn OFF once the real feed is live.
CROWD_SIMULATOR_ENABLED=true
CROWD_SIMULATOR_INTERVAL_SECONDS=300

# --- Domain defaults -------------------------------------------------------
DEFAULT_LANGUAGE=mr
FACILITY_DEFAULT_RADIUS_M=1500
FACILITY_MAX_RADIUS_M=20000
EMERGENCY_HELPLINE=112
WARI_CONTROL_ROOM=1800-233-1000
# Optional. When set (and SMS_PROVIDER is configured) every SOS also texts this
# number. Unset means the Redis `sos:new` feed is the only alert path.
CONTROL_ROOM_PHONE=

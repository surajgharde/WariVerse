EXPO_PUBLIC_MAPBOX_TOKEN=replace-with-your-mapbox-token

# Base URL of the WariVerse backend. Copy this file to .env.local and adjust.
# Physical device: `localhost` is the phone — use your machine's LAN IP instead
# (e.g. http://192.168.1.20:8000). Unset, the app derives it from the Metro host.
EXPO_PUBLIC_API_URL=http://localhost:8000
